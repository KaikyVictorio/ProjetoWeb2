PORT=3001
CORS_ORIGIN=http://localhost:5173
# Troque por um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo
# Arquivo do banco SQLite (a pasta é criada automaticamente)
DB_PATH=./data/estante.db
# Defina SEED=false para não popular o banco com os dados de exemplo
SEED=true
# Microsserviço de seguidores (services/social)
SOCIAL_URL=http://localhost:4002
# Microsserviços de favoritos e wishlist (services/favoritos e services/wishlist)
FAVORITOS_URL=http://localhost:4003
WISHLIST_URL=http://localhost:4004
# Senha entre serviços; use o MESMO valor nos services/social, favoritos e wishlist
INTERNAL_TOKEN=token-interno-dev
